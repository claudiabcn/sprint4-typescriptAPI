{
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",

    "module": "ES6",
    "target": "ES6",
    "lib": ["ES6", "DOM"],

    "sourceMap": true,
    "strict": true,
    "skipLibCheck": true,
    "moduleResolution": "node"
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules"]
}
